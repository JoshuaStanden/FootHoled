# FootHoled H1 sdkconfig.defaults
# Target: Waveshare ESP32-S3-Touch-LCD-3.5 (ESP32-S3R8, 16 MB flash, 8 MB PSRAM)
# TODO(HW): verify SPIRAM mode (octal vs quad) on the physical board revision.

# Flash + partition table.
# idf.py ignores partitions.csv unless the custom table is selected here (the
# default single-app table gives only a 1 MB factory slot, which the ~1.7 MB
# app overflows). 16 MB flash must also be declared or the 6M/6M slots in
# partitions.csv run off the end of a default 2 MB image.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Guarantee internal DMA RAM for the LVGL display buffers (ROBUST fix).
# The ST7796 SPI panel needs its source pixels in DMA-capable INTERNAL RAM
# (S3 SPI-DMA can't read PSRAM; a PSRAM source forces a per-flush internal
# bounce buffer that failed once Wi-Fi + NimBLE fragmented internal RAM:
# "spicommon_dma_setup_priv_buffer: Failed to allocate priv TX buffer").
# Instead of racing the radios for a contiguous block, reserve the internal
# DMA pool up front and push the radios' own buffers into PSRAM:
#   - RESERVE_INTERNAL 128 KB: a DMA/internal-only pool normal malloc() cannot
#     touch, so the ~45 KB of draw buffers (and FreeRTOS stacks) always fit.
#   - TRY_ALLOCATE_WIFI_LWIP: Wi-Fi + LWIP buffers go to PSRAM first.
#   - ALLOW_BSS_SEG_EXTERNAL_MEMORY: net80211/pp/bt/lwip .bss moves to PSRAM.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Larger main task stack for LVGL initialisation
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable the new I2C master driver (used by board_adapter.cpp for touch)
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# SPI: allow large DMA transfers for the 320x480 frame buffer
CONFIG_SPI_MASTER_IN_IRAM=y

# Bluetooth: enable the controller + NimBLE host for BLE recon (ble_scan.cpp).
# TODO(HW): confirm on the real board ΓÇö the ESP32-S3 is BLE-only (no Classic BT),
# so NimBLE in central/observer mode is the correct, lightest choice here.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# We only observe (scan); no peripheral/advertising roles needed.
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n

# SD card recon log (recon_log.cpp): FatFs over the onboard SDMMC slot.
# The card MUST be formatted FAT32 (FatFs supports FAT32/exFAT only; ext2/3/4
# are NOT supported). Long filenames stored on the heap keep IRAM pressure low.
# TODO(HW): to support 64 GB+ cards formatted exFAT, also set
#   CONFIG_FATFS_LONG_FILENAMES and the exFAT option (CONFIG_FATFS_API_ENCODING).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# LVGL (lvgl/lvgl 9.2.2) configuration via Kconfig.
# idf.py does NOT read src/lv_conf.h, so LVGL is configured here instead; these
# must stay in sync with the app's expectations (see firmware/CMakeLists.txt).
# Skip any custom lv_conf.h so the LVGL component and the app agree on one config.
CONFIG_LV_CONF_SKIP=y
# 16-bit RGB565 to match the ST7796 panel (bits_per_pixel=16 in board_adapter.cpp).
CONFIG_LV_COLOR_DEPTH_16=y
# Fonts: 14px is the UI default (ui.cpp); 28px is the boot-splash wordmark (splash.cpp).
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# Flex layout is used by every screen (lv_obj_set_flex_flow).
CONFIG_LV_USE_FLEX=y
# Widgets the app instantiates (match the removed lv_conf.h set): label + line +
# bar for the splash (splash.cpp); button, switch, slider for the UI (ui.cpp).
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_SWITCH=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_SLIDER=y
CONFIG_LV_USE_LINE=y
# Image widget: ui.cpp's boot splash draws the RGB565 logo (splash_logo.cpp)
# via lv_image_create()/lv_image_set_src().
CONFIG_LV_USE_IMAGE=y
# Use newlib (CLIB) for malloc/string/sprintf, matching the old lv_conf.h.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# Software complex draw engine (default y in LVGL) is required by the
# IMU-driven software rotation in board_adapter.cpp flush_cb(); pin it on.
CONFIG_LV_USE_DRAW_SW=y
CONFIG_LV_DRAW_SW_COMPLEX=y

# ---------------------------------------------------------------------------
# Wi-Fi buffer budget — free INTERNAL (DMA-capable) RAM for the SD card.
# The SD driver allocates its transfer buffer from internal DMA RAM on every
# read/write (sdmmc allocate_dma_buf). Under a dense Wi-Fi scan (thousands of
# APs) the Wi-Fi driver's STATIC RX buffers — allocated in internal RAM at
# esp_wifi_init and held until esp_wifi_deinit — consumed enough that the SD
# DMA allocation failed ("allocate_dma_buf: not enough mem, err=0x101"). We
# only SCAN (never associate / move TCP traffic), so large buffer pools are
# unnecessary. NOTE: with SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y the TX buffers are
# already static-in-PSRAM-preferred (the dynamic-TX choice is unavailable), so
# the lever that matters is the STATIC RX count + the cache-TX queue:
#   - STATIC_RX_BUFFER_NUM 4 (was default 16): ~1.6 KB each -> frees ~19 KB
#     internal RAM. These are the buffers freed by the per-screen deinit too.
#   - DYNAMIC_RX_BUFFER_NUM 16: plenty for scan-only (default 32).
#   - CACHE_TX_BUFFER_NUM 8 (was 32): cache-TX queue is for uplayer TX we never
#     generate; shrink it. (Valid only with SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y.)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
# The AMPDU RX Block-Ack window must be <= 2 x STATIC_RX_BUFFER_NUM, or the
# esp_wifi build-time check fails. With PSRAM-preferred Wi-Fi the default is 16,
# which exceeds 2x4=8, so pin it to 8. BA window only affects throughput on an
# ASSOCIATED connection; we only scan (never associate), so 8 costs us nothing.
CONFIG_ESP_WIFI_RX_BA_WIN=8
